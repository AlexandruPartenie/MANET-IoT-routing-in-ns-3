#!/usr/bin/env python3
"""Writes FAKE logs in the exact format of manet-compare.cc, to test run_matrix/analyze plumbing
without ns-3. The numbers are random and mean nothing - never use them in the report."""
import os, sys
import numpy as np

out = sys.argv[1] if len(sys.argv) > 1 else "tests/synthetic_raw"
POINTS = [(25, 0), (50, 0), (100, 0), (50, 1), (50, 10)]
for proto in ["aodv", "olsr", "dsdv"]:
    for n, v in POINTS:
        for seed in range(1, 6):
            rng = np.random.default_rng(hash((proto, n, v, seed)) % 2**32)
            d = f"{out}/{proto}_n{n}_v{v}_s{seed}"
            os.makedirs(d, exist_ok=True)
            flows = [(f, *rng.choice(n, 2, replace=False)) for f in range(10)]
            with open(f"{d}/flows.csv", "w") as fh:
                fh.write("flow,src,dst\n")
                for f, s, t in flows: fh.write(f"{f},{s},{t}\n")
            with open(f"{d}/pos.csv", "w") as fh:
                fh.write("t,node,x,y\n")
                for t in range(0, 201, 5):
                    for i in range(n): fh.write(f"{t},{i},{rng.uniform(0,500)},{rng.uniform(0,500)}\n")
            ptx = open(f"{d}/tx.csv", "w"); prx = open(f"{d}/rx.csv", "w")
            ptx.write("flow,seq,t_tx,src,dst\n"); prx.write("flow,seq,t_tx,t_rx,hops\n")
            for f, s, t in flows:
                for q in range(396):
                    tt = 1.5 + q * 0.5
                    ptx.write(f"{f},{q},{tt},{s},{t}\n")
                    if rng.random() < 0.9 - 0.001 * n:
                        prx.write(f"{f},{q},{tt},{tt + rng.exponential(0.02)},{rng.integers(1,5)}\n")
            ptx.close(); prx.close()
            with open(f"{d}/ctrl.csv", "w") as fh:
                fh.write("node,ctrl_pkts,ctrl_bytes,data_tx\n")
                for i in range(n): fh.write(f"{i},{rng.integers(100,900)},{rng.integers(1e4,9e4)},{rng.integers(0,300)}\n")
            with open(f"{d}/summary.csv", "w") as fh:
                fh.write("protocol,nodes,speed,seed,sim_time,warmup,send_stop,flows,rate_pps,payload_bytes,wall_s\n")
                fh.write(f"{proto},{n},{v},{seed},200,20,198,10,2,128,{rng.uniform(5,300)}\n")
            open(f"{d}/.done", "w").close()
print("wrote", out)
